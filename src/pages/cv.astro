---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { skillCategories, languages } from '../data/skills';
import { formatDateRange, formatMonthYear } from '../lib/date';
import I18nText from '../components/I18nText.astro';

// Reuso las mismas content collections que el home (Proyectos, Experiencia
// y Estudios): agregar/editar un archivo en src/content/ actualiza todas las vistas a la vez.
// Proyectos y Experiencia usan acá una selección/orden curados para el CV
// (campo `cvOrder` en el frontmatter), distinto del orden del home: el CV
// es un resumen, no el catálogo completo. Un proyecto sin `cvOrder` no
// aparece en el CV; una experiencia sin `cvOrder` cae al final por fecha.

const projects = (await getCollection('projects'))
  .filter((entry) => entry.data.cvOrder != null)
  .sort((a, b) => (a.data.cvOrder ?? 0) - (b.data.cvOrder ?? 0));
const experience = (await getCollection('experience')).sort((a, b) => {
  if (a.data.cvOrder != null && b.data.cvOrder != null) return a.data.cvOrder - b.data.cvOrder;
  if (a.data.cvOrder != null) return -1;
  if (b.data.cvOrder != null) return 1;
  return b.data.startDate.localeCompare(a.data.startDate);
});
const education = (await getCollection('education')).sort((a, b) =>
  b.data.startDate.localeCompare(a.data.startDate)
);

const email = site.email.replace('mailto:', '');
---

<BaseLayout title={`CV — ${site.name}`} description={`Currículum de ${site.name}, ${site.role}.`}>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <div class="no-print mb-8 flex flex-col items-end gap-3">
      <div class="flex flex-wrap justify-end gap-3">
        <button
          type="button"
          data-print-lang="es"
          data-print-density="full"
          class="rounded-full bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-emerald-500"
        >
          Descargar PDF (Español)
        </button>
        <button
          type="button"
          data-print-lang="en"
          data-print-density="full"
          class="rounded-full border border-emerald-600 px-5 py-2.5 text-sm font-semibold text-emerald-700 transition-colors hover:bg-emerald-50 dark:text-emerald-400 dark:hover:bg-emerald-400/10"
        >
          Download PDF (English)
        </button>
      </div>
      <div class="flex flex-wrap items-center justify-end gap-3">
        <span class="text-xs text-zinc-500 dark:text-zinc-400">Resumido (2 carillas):</span>
        <button
          type="button"
          data-print-lang="es"
          data-print-density="compact"
          class="rounded-full border border-zinc-300 px-4 py-2 text-xs font-semibold text-zinc-600 transition-colors hover:border-emerald-500 hover:text-emerald-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-emerald-400 dark:hover:text-emerald-400"
        >
          PDF (Español)
        </button>
        <button
          type="button"
          data-print-lang="en"
          data-print-density="compact"
          class="rounded-full border border-zinc-300 px-4 py-2 text-xs font-semibold text-zinc-600 transition-colors hover:border-emerald-500 hover:text-emerald-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-emerald-400 dark:hover:text-emerald-400"
        >
          PDF (English)
        </button>
      </div>
    </div>

    <!-- Encabezado -->
    <div class="cv-block mb-10 flex flex-wrap items-center gap-6 border-b border-zinc-200 pb-8 print:mb-5 print:gap-4 print:pb-4 dark:border-zinc-800">
      <img
        src={site.avatar}
        alt={site.name}
        width="112"
        height="112"
        class="size-24 shrink-0 rounded-full object-cover ring-4 ring-white compact:size-16 dark:ring-zinc-900"
      />
      <div class="min-w-0 flex-1">
        <h1 class="font-heading text-3xl font-bold compact:text-2xl">{site.name}</h1>
        <p class="mt-1 text-lg text-emerald-600 compact:text-base dark:text-emerald-400">
          <I18nText es={site.role} en={site.roleEn} />
        </p>
        <p class="mt-3 text-sm print:text-xs text-zinc-600 dark:text-zinc-400">
          {site.location} ·{' '}
          <a href={site.phoneUrl} class="hover:text-emerald-600 dark:hover:text-emerald-400">
            {site.phone}
          </a>{' '}
          ·{' '}
          <a href={`mailto:${email}`} class="hover:text-emerald-600 dark:hover:text-emerald-400">
            {email}
          </a>
          {
            site.social
              .filter((s) => s.icon !== 'email')
              .map((s) => (
                <>
                  {' '}
                  ·{' '}
                  <a href={s.url} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 dark:hover:text-emerald-400">
                    {s.label}
                  </a>
                </>
              ))
          }
        </p>
        {
          site.resumeUrl && (
            <a href={site.resumeUrl} class="no-print mt-3 inline-block text-sm text-zinc-500 underline decoration-zinc-300 hover:text-emerald-600 dark:text-zinc-400 dark:decoration-zinc-700">
              <I18nText es="Descargar el PDF original →" en="Download the original PDF →" />
            </a>
          )
        }
      </div>
    </div>

    <!-- Sobre mí -->
    <section class="mb-10 print:mb-5">
      <h2 class="border-b border-zinc-200 pb-2 font-heading text-xl font-semibold text-zinc-900 compact:text-base dark:border-zinc-800 dark:text-zinc-50">
        <I18nText es="Sobre mí" en="About me" />
      </h2>
      <p class="mt-3 whitespace-pre-line text-sm print:text-xs text-zinc-600 dark:text-zinc-400">
        <I18nText es={site.bio} en={site.bioEn} />
      </p>
    </section>

    <!-- Habilidades -->
    <section class="mb-10 print:mb-5">
      <h2 class="border-b border-zinc-200 pb-2 font-heading text-xl font-semibold text-zinc-900 compact:text-base dark:border-zinc-800 dark:text-zinc-50">
        <I18nText es="Habilidades" en="Skills" />
      </h2>
      <dl class="mt-4 space-y-3 print:mt-2 print:space-y-1.5">
        {
          skillCategories.map((group) => (
            <div class="grid grid-cols-1 gap-1 sm:grid-cols-[9rem_1fr] sm:gap-3">
              <dt class="text-sm print:text-xs font-semibold text-zinc-700 compact:text-xs dark:text-zinc-300">
                <I18nText es={group.category} en={group.categoryEn} />
              </dt>
              <dd class="text-sm print:text-xs text-zinc-600 compact:text-xs dark:text-zinc-400">
                <I18nText es={group.items.join(', ')} en={(group.itemsEn ?? group.items).join(', ')} />
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Proyectos -->
    <section class="mb-10 print:mb-5">
      <h2 class="border-b border-zinc-200 pb-2 font-heading text-xl font-semibold text-zinc-900 compact:text-base dark:border-zinc-800 dark:text-zinc-50">
        <I18nText es="Proyectos" en="Projects" />
      </h2>
      <div class="mt-4 space-y-5 print:mt-2 print:space-y-3">
        {
          projects.map((entry) => {
            const d = entry.data;
            return (
              <div class="cv-block">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                  <h3 class="text-sm print:text-xs font-semibold text-zinc-800 dark:text-zinc-200">
                    <I18nText es={d.title} en={d.titleEn ?? d.title} />
                    {d.featured && (
                      <span class="ml-1.5 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                        <I18nText es="(destacado)" en="(featured)" />
                      </span>
                    )}
                  </h3>
                  {d.date && (
                    <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">
                      <I18nText es={formatMonthYear(d.date).es} en={formatMonthYear(d.date).en} />
                    </span>
                  )}
                </div>
                <p class="mt-1 text-sm print:text-xs text-zinc-600 dark:text-zinc-400">
                  <I18nText es={d.description} en={d.descriptionEn ?? d.description} />
                </p>
                <p class="mt-1 flex flex-wrap items-baseline gap-x-1.5 text-xs text-zinc-500 dark:text-zinc-500">
                  <I18nText es={d.tags.join(' · ')} en={(d.tagsEn ?? d.tags).join(' · ')} />
                  {(d.repoUrl || d.demoUrl) && (
                    <span class="font-semibold text-zinc-600 dark:text-zinc-300">
                      ·{' '}
                      {d.repoUrl && (
                        <a href={d.repoUrl} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 dark:hover:text-emerald-400">
                          {d.repoUrl.replace(/^https?:\/\//, '')}
                        </a>
                      )}
                      {d.repoUrl && d.demoUrl && ' · '}
                      {d.demoUrl && (
                        <a href={d.demoUrl} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 dark:hover:text-emerald-400">
                          {d.demoUrl.replace(/^https?:\/\//, '')}
                        </a>
                      )}
                    </span>
                  )}
                </p>
              </div>
            );
          })
        }
      </div>
      <p class="mt-3 hidden text-xs text-zinc-500 compact:mt-1 compact:block dark:text-zinc-500">
        <I18nText
          es={`Más proyectos en ${site.social.find((s) => s.icon === 'github')?.url.replace(/^https?:\/\//, '')}`}
          en={`More projects at ${site.social.find((s) => s.icon === 'github')?.url.replace(/^https?:\/\//, '')}`}
        />
      </p>
    </section>

    <!-- Experiencia -->
    <section class="mb-10 print:mb-5">
      <h2 class="border-b border-zinc-200 pb-2 font-heading text-xl font-semibold text-zinc-900 compact:text-base dark:border-zinc-800 dark:text-zinc-50">
        <I18nText es="Experiencia" en="Experience" />
      </h2>
      <div class="mt-4 space-y-6 print:mt-2 print:space-y-3">
        {
          experience.map((entry) => {
            const d = entry.data;
            const titleEs = `${d.role} · ${d.company}`;
            const titleEn = `${d.roleEn ?? d.role} · ${d.companyEn ?? d.company}`;
            const dateRange = formatDateRange(d.startDate, d.endDate);
            const bullets = d.cvBullets ?? d.bullets;
            const bulletsEn = d.cvBullets ? (d.cvBulletsEn ?? d.cvBullets) : d.bulletsEn;
            return (
              <div class="cv-block">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                  <h3 class="text-sm print:text-xs font-semibold text-zinc-800 dark:text-zinc-200">
                    <I18nText es={titleEs} en={titleEn} />
                  </h3>
                  <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">
                    <I18nText es={dateRange.es} en={dateRange.en} />
                  </span>
                </div>
                {d.url && (
                  <a href={d.url} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-zinc-500 hover:text-emerald-600 dark:text-zinc-400 dark:hover:text-emerald-400">
                    {d.url.replace(/^https?:\/\//, '')}
                  </a>
                )}
                {bullets.length > 0 && (
                  <ul class="mt-1 list-disc space-y-1 pl-5 text-sm print:text-xs text-zinc-600 marker:text-emerald-500 dark:text-zinc-400">
                    {bullets.map((bullet, i) => (
                      <li>
                        <I18nText es={bullet} en={bulletsEn?.[i] ?? bullet} />
                      </li>
                    ))}
                  </ul>
                )}
                {!d.cvBullets && d.tags.length > 0 && (
                  <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-500">
                    <I18nText es={d.tags.join(' · ')} en={(d.tagsEn ?? d.tags).join(' · ')} />
                  </p>
                )}
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- Estudios -->
    <section class="mb-10 print:mb-5">
      <h2 class="border-b border-zinc-200 pb-2 font-heading text-xl font-semibold text-zinc-900 compact:text-base dark:border-zinc-800 dark:text-zinc-50">
        <I18nText es="Estudios" en="Education" />
      </h2>
      <div class="mt-4 space-y-3 print:mt-2 print:space-y-1.5">
        {
          education.map((entry) => {
            const d = entry.data;
            const dateRange = formatDateRange(d.startDate, d.endDate);
            return (
              <div class="cv-block flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                <div>
                  <h3 class="text-sm print:text-xs font-semibold text-zinc-800 dark:text-zinc-200">
                    <I18nText es={d.title} en={d.titleEn ?? d.title} />
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-500">
                    <I18nText es={d.institution} en={d.institutionEn ?? d.institution} />
                  </p>
                </div>
                <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">
                  <I18nText es={dateRange.es} en={dateRange.en} />
                </span>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- Idiomas -->
    <section>
      <h2 class="border-b border-zinc-200 pb-2 font-heading text-xl font-semibold text-zinc-900 compact:text-base dark:border-zinc-800 dark:text-zinc-50">
        <I18nText es="Idiomas" en="Languages" />
      </h2>
      <ul class="mt-4 space-y-1 print:mt-2">
        {
          languages.map((lang) => (
            <li class="text-sm print:text-xs text-zinc-600 dark:text-zinc-400">
              <span class="font-semibold text-zinc-800 dark:text-zinc-200">
                <I18nText es={`${lang.name}:`} en={`${lang.nameEn}:`} />
              </span>{' '}
              <I18nText es={lang.level} en={lang.levelEn} />
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  // Los botones fuerzan el idioma y la densidad (completo/resumido) del
  // <html> antes de imprimir, sin importar el toggle ES/EN actual, y los
  // restauran al cerrar el diálogo para no pisar la preferencia del visitante.
  document.querySelectorAll<HTMLButtonElement>('[data-print-lang]').forEach((button) => {
    button.addEventListener('click', () => {
      const html = document.documentElement;
      const previousLang = html.getAttribute('data-lang') ?? 'es';
      const previousDensity = html.getAttribute('data-cv-density') ?? 'full';
      const printLang = button.dataset.printLang as 'es' | 'en';
      const printDensity = button.dataset.printDensity as 'full' | 'compact';

      const restore = () => {
        html.setAttribute('data-lang', previousLang);
        html.lang = previousLang;
        html.setAttribute('data-cv-density', previousDensity);
        window.removeEventListener('afterprint', restore);
      };

      html.setAttribute('data-lang', printLang);
      html.lang = printLang;
      html.setAttribute('data-cv-density', printDensity);
      window.addEventListener('afterprint', restore);
      window.print();
    });
  });
</script>
