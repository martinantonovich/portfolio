---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
import I18nText from './I18nText.astro';

const email = site.email.replace('mailto:', '');
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<section id="contacto" class="mx-auto max-w-3xl px-6 py-20">
  <div data-reveal class="text-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
      <I18nText es="Contacto" en="Contact" />
    </h2>
    <p class="mt-3 text-zinc-600 dark:text-zinc-400">
      <I18nText
        es="¿Tenés un proyecto en mente o una oportunidad para charlar? Escribime."
        en="Have a project in mind or an opportunity to talk about? Get in touch."
      />
    </p>

    <div class="mt-6 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a
        href={`mailto:${email}`}
        class="rounded-full bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-emerald-500"
      >
        {email}
      </a>
      <SocialLinks />
    </div>
  </div>

  <form id="contact-form" data-reveal class="mt-12 grid gap-4">
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="name" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">
          <I18nText es="Nombre" en="Name" />
        </label>
        <input
          id="name"
          name="name"
          type="text"
          required
          class="w-full rounded-lg border border-zinc-300 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:border-zinc-700 dark:bg-zinc-900"
        />
      </div>
      <div>
        <label for="reply-email" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">
          <I18nText es="Tu email" en="Your email" />
        </label>
        <input
          id="reply-email"
          name="email"
          type="email"
          required
          class="w-full rounded-lg border border-zinc-300 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:border-zinc-700 dark:bg-zinc-900"
        />
      </div>
    </div>

    <div>
      <label for="subject" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">
        <I18nText es="Asunto" en="Subject" />
      </label>
      <input
        id="subject"
        name="subject"
        type="text"
        required
        class="w-full rounded-lg border border-zinc-300 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:border-zinc-700 dark:bg-zinc-900"
      />
    </div>

    <div>
      <label for="message" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">
        <I18nText es="Mensaje" en="Message" />
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        class="w-full rounded-lg border border-zinc-300 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:border-zinc-700 dark:bg-zinc-900"
      ></textarea>
    </div>

    <div class="flex items-center gap-4">
      <button
        type="submit"
        class="justify-self-start rounded-full bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-zinc-700 disabled:cursor-not-allowed disabled:opacity-60 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white"
      >
        <I18nText es="Enviar mensaje" en="Send message" />
      </button>
      <p id="contact-status" class="hidden text-sm" role="status"></p>
    </div>
  </form>
</section>

<script define:vars={{ email, web3formsKey }} is:inline>
  document.getElementById('contact-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const submitButton = form.querySelector('button[type="submit"]');
    const status = document.getElementById('contact-status');
    const isEn = () => document.documentElement.getAttribute('data-lang') === 'en';

    const setStatus = (text, tone) => {
      status.textContent = text;
      status.classList.remove('hidden', 'text-red-600', 'text-emerald-600', 'text-zinc-500');
      status.classList.add(tone);
    };

    // Sin access key configurada (falta PUBLIC_WEB3FORMS_KEY): fallback a mailto.
    if (!web3formsKey) {
      const data = new FormData(form);
      const name = data.get('name')?.toString() ?? '';
      const subject = data.get('subject')?.toString() ?? '';
      const message = data.get('message')?.toString() ?? '';
      const body = `${message}\n\n— ${name}`;
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      return;
    }

    const data = new FormData(form);
    data.append('access_key', web3formsKey);
    data.append('subject', `[Portfolio] ${data.get('subject')}`);
    data.append('from_name', data.get('name'));
    data.append('botcheck', '');

    submitButton.disabled = true;
    setStatus(isEn() ? 'Sending…' : 'Enviando…', 'text-zinc-500');

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      });
      const result = await response.json();

      if (result.success) {
        setStatus(
          isEn() ? 'Message sent — thanks for reaching out!' : '¡Mensaje enviado! Gracias por escribirme.',
          'text-emerald-600',
        );
        form.reset();
      } else {
        throw new Error(result.message || 'Unknown error');
      }
    } catch {
      setStatus(
        isEn()
          ? "Couldn't send the message. Try again or email me directly."
          : 'No se pudo enviar el mensaje. Probá de nuevo o escribime directo por mail.',
        'text-red-600',
      );
    } finally {
      submitButton.disabled = false;
    }
  });
</script>
