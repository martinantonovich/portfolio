---
import { getCollection } from 'astro:content';
import EducationItem from './EducationItem.astro';
import I18nText from './I18nText.astro';

// Para agregar un estudio/curso/certificación nuevo: 
// tengo que copiar un archivo desrc/content/education/*.md y completar el frontmatter
const allEducation = await getCollection('education');
const education = allEducation.sort((a, b) => b.data.startDate.localeCompare(a.data.startDate));
---

<section id="estudios" class="bg-zinc-100/60 py-20 dark:bg-zinc-900/40">
  <div class="mx-auto max-w-5xl px-6">
    <div data-reveal class="mb-12 text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        <I18nText es="Estudios" en="Education" />
      </h2>
      <p class="mt-3 text-zinc-600 dark:text-zinc-400">
        <I18nText es="Formación, cursos y certificaciones." en="Education, courses, and certifications." />
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      {education.map((entry) => <EducationItem education={entry} />)}
    </div>
  </div>
</section>
