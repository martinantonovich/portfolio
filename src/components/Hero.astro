---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
import I18nText from './I18nText.astro';
---

<section class="mx-auto flex max-w-5xl flex-col-reverse items-center gap-10 px-6 pt-16 pb-24 md:flex-row md:pt-24 md:pb-32">
  <div data-reveal class="flex-1 text-center md:text-left">
    <p class="mb-3 font-medium text-emerald-600 dark:text-emerald-400">
      <I18nText es={`Hola, soy ${site.name} 👋`} en={`Hi, I'm ${site.name} 👋`} />
    </p>
    <h1 class="text-4xl leading-tight font-bold tracking-tight sm:text-5xl">
      <I18nText es={site.role} en={site.roleEn} />
    </h1>
    <p class="mt-5 text-lg text-zinc-600 dark:text-zinc-400">
      <I18nText es={site.tagline} en={site.taglineEn} />
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4 md:justify-start">
      <a
        href="#proyectos"
        class="rounded-full bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-emerald-500"
      >
        <I18nText es="Ver proyectos" en="View projects" />
      </a>
      <a
        href="#contacto"
        class="rounded-full border border-zinc-300 px-5 py-2.5 text-sm font-semibold text-zinc-700 transition-colors hover:border-emerald-500 hover:text-emerald-600 dark:border-zinc-700 dark:text-zinc-200 dark:hover:border-emerald-400 dark:hover:text-emerald-400"
      >
        <I18nText es="Contactarme" en="Contact me" />
      </a>
      <a
        href="/cv"
        class="text-sm font-semibold text-zinc-500 underline decoration-zinc-300 underline-offset-4 hover:text-emerald-600 dark:text-zinc-400 dark:decoration-zinc-700"
      >
        <I18nText es="Ver CV" en="View resume" />
      </a>
    </div>

    <SocialLinks class="mt-8 justify-center md:justify-start" />
  </div>

  <div data-reveal class="shrink-0">
    <img
      src={site.avatar}
      alt={site.name}
      width="176"
      height="176"
      class="size-36 rounded-full ring-4 ring-white sm:size-44 dark:ring-zinc-900"
    />
  </div>
</section>
