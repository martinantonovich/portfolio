---
import { getCollection } from 'astro:content';
import ExperienceItem from './ExperienceItem.astro';
import I18nText from './I18nText.astro';

// Para agregar una experiencia nueva: 
// Tengo que copiar un archivo de src/content/experience/*.mdy completar el frontmatter.
const allExperience = await getCollection('experience');
const experiences = allExperience.sort((a, b) => b.data.startDate.localeCompare(a.data.startDate));
---

<section id="experiencia" class="mx-auto max-w-3xl px-6 py-20">
  <div data-reveal class="mb-12 text-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
      <I18nText es="Experiencia" en="Experience" />
    </h2>
    <p class="mt-3 text-zinc-600 dark:text-zinc-400">
      <I18nText es="Mi recorrido profesional hasta ahora." en="My professional journey so far." />
    </p>
  </div>

  <div>
    {
      experiences.map((experience, index) => (
        <ExperienceItem experience={experience} isLast={index === experiences.length - 1} />
      ))
    }
  </div>
</section>
