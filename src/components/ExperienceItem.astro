---
import type { CollectionEntry } from 'astro:content';
import { formatDateRange } from '../lib/date';
import I18nText from './I18nText.astro';

interface Props {
  experience: CollectionEntry<'experience'>;
  isLast: boolean;
}

const { experience, isLast } = Astro.props;
const {
  company,
  companyEn,
  role,
  roleEn,
  location,
  locationEn,
  startDate,
  endDate,
  tags,
  tagsEn,
  bullets,
  bulletsEn,
  url,
} = experience.data;

const titleEs = `${role} · ${company}`;
const titleEn = `${roleEn ?? role} · ${companyEn ?? company}`;
const dateRange = formatDateRange(startDate, endDate);
---

<div data-reveal class="relative pl-10 sm:pl-14">
  <!-- Línea vertical del timeline -->
  {!isLast && <span class="absolute top-3 left-[7px] h-[calc(100%+2rem)] w-px bg-zinc-200 sm:left-[11px] dark:bg-zinc-800" />}
  <!-- Punto del timeline -->
  <span class="absolute top-1.5 left-0 size-3.5 rounded-full border-2 border-emerald-500 bg-zinc-50 sm:size-5 dark:bg-zinc-950"></span>

  <div class="pb-10">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="font-heading text-lg font-semibold">
        <I18nText es={titleEs} en={titleEn} />
      </h3>
      <span class="text-sm font-medium text-emerald-600 dark:text-emerald-400">
        <I18nText es={dateRange.es} en={dateRange.en} />
      </span>
    </div>

    {location && (
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-500">
        <I18nText es={location} en={locationEn ?? location} />
      </p>
    )}

    {
      url && (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-1 inline-block text-sm font-semibold text-zinc-600 transition-colors hover:text-emerald-600 dark:text-zinc-300 dark:hover:text-emerald-400"
        >
          <I18nText es="Ver sitio →" en="View site →" />
        </a>
      )
    }

    {
      bullets.length > 0 && (
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-zinc-600 marker:text-emerald-500 dark:text-zinc-400">
          {bullets.map((bullet, i) => (
            <li>
              <I18nText es={bullet} en={bulletsEn?.[i] ?? bullet} />
            </li>
          ))}
        </ul>
      )
    }

    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2">
          {tags.map((tag, i) => (
            <li class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
              <I18nText es={tag} en={tagsEn?.[i] ?? tag} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
