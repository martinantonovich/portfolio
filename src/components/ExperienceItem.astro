---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { formatDateRange } from '../lib/date';

interface Props {
  experience: CollectionEntry<'experience'>;
  isLast: boolean;
}

const { experience, isLast } = Astro.props;
const { company, role, location, startDate, endDate, tags } = experience.data;
const { Content } = await render(experience);
---

<div data-reveal class="relative pl-10 sm:pl-14">
  <!-- Línea vertical del timeline -->
  {!isLast && <span class="absolute top-3 left-[7px] h-[calc(100%+2rem)] w-px bg-zinc-200 sm:left-[11px] dark:bg-zinc-800" />}
  <!-- Punto del timeline -->
  <span class="absolute top-1.5 left-0 size-3.5 rounded-full border-2 border-emerald-500 bg-zinc-50 sm:size-5 dark:bg-zinc-950"></span>

  <div class="pb-10">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="font-heading text-lg font-semibold">{role} · {company}</h3>
      <span class="text-sm font-medium text-emerald-600 dark:text-emerald-400">
        {formatDateRange(startDate, endDate)}
      </span>
    </div>

    {location && <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-500">{location}</p>}

    <div class="prose prose-zinc prose-sm mt-3 max-w-none text-zinc-600 marker:text-emerald-500 dark:prose-invert dark:text-zinc-400">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
