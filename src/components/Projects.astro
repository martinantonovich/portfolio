---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import I18nText from './I18nText.astro';

// Para agregar un proyecto nuevo: 
// Tengo que copiar un archivo de src/content/projects/*.md y completar el frontmatter.
const allProjects = await getCollection('projects');

const projects = allProjects.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return (b.data.date ?? '').localeCompare(a.data.date ?? '');
});
---

<section id="proyectos" class="mx-auto max-w-5xl px-6 py-20">
  <div data-reveal class="mb-12 text-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
      <I18nText es="Proyectos" en="Projects" />
    </h2>
    <p class="mt-3 text-zinc-600 dark:text-zinc-400">
      <I18nText es="Algunas cosas que construí, del backend a la automatización." en="Some things I've built, from backend to automation." />
    </p>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project) => (
        <div data-reveal>
          <ProjectCard project={project} />
        </div>
      ))
    }
  </div>
</section>
