---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

// Para agregar un proyecto nuevo: copiá un archivo de src/content/projects/*.md
// y completá el frontmatter. No hace falta tocar este componente.
const allProjects = await getCollection('projects');

const projects = allProjects.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return (b.data.date ?? '').localeCompare(a.data.date ?? '');
});
---

<section id="proyectos" class="mx-auto max-w-5xl px-6 py-20">
  <div data-reveal class="mb-12 text-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Proyectos</h2>
    <p class="mt-3 text-zinc-600 dark:text-zinc-400">Algunas cosas que construí, del backend a la automatización.</p>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project) => (
        <div data-reveal>
          <ProjectCard project={project} />
        </div>
      ))
    }
  </div>
</section>
